generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  fullName       String?
  passwordHash   String?
  role           String?        @default("user")
  isVerified     Boolean?       @default(false)
  targetLanguage String?        @default("English")
  createdAt      DateTime       @default(now())
  sessions       Session[]
  flashcards     Flashcard[]
  scenarios      Scenario[]
  engagementStat UserEngagementStat?

  @@map("users")
}

model UserEngagementStat {
  email         String      @id
  user          User        @relation(fields: [email], references: [email], onDelete: Cascade)
  score         Int?        @default(0)
  currentStreak Int?        @default(0) @map("current_streak")
  longestStreak Int?        @default(0) @map("longest_streak")
  totalXp       Int?        @default(0) @map("total_xp")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("user_engagement_stats")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  language   String
  level      String    @default("A1")
  scenarioId String?   @map("scenario_id")
  scenario   Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  endedAt    DateTime? @map("ended_at")
  createdAt  DateTime  @default(now())
  messages   Message[]

  @@map("chat_sessions")
}

model Scenario {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  language    String
  type        String    @default("language")
  templateId  String?
  createdAt   DateTime  @default(now())
  sessions    Session[]

  @@index([userId])
  @@map("scenarios")
}

model Message {
  id           String    @id @default(uuid())
  sessionId    String
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         String    // 'user' | 'ai'
  content      String?
  analysisJson Json?     @map("analysis_json")
  createdAt    DateTime  @default(now())

  @@map("chat_messages")
}

model Flashcard {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  frontText       String   @map("front_text")
  backText        String   @map("back_text")
  language        String   @default("English")
  createdAt       DateTime @default(now())

  @@map("flashcards")
}
