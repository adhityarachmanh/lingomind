# Copy this file to scripts/deploy.local.env and fill your own values.
# Example:
#   cp scripts/deploy.local.env.example scripts/deploy.local.env

VPS_HOST="lingomind.my.id"
VPS_USER="deploy"
SSH_KEY="$HOME/.ssh/lingomind_deploy"

REMOTE_APP_DIR="/home/deploy/lingomind"
REMOTE_RELEASE_DIR="/opt/lingomind/current"
SERVICE_NAME="lingomind"

# Branch to deploy from remote git repository.
BRANCH="main"

# Build mode:
# - debug   -> `dx bundle --web` (more stable if wasm-opt release still fails)
# - release -> `dx bundle --web --release`
BUILD_MODE="debug"

# Optional. For low-spec VPS, keep this small.
CARGO_BUILD_JOBS="1"
